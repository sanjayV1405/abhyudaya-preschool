# ==============================================================================
# Abhyudaya Preschool — Supabase & Environment Configuration
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (found in Supabase Dashboard -> Project Settings -> API -> anon public / publishable key)
# Safe to use in browser with Row Level Security (RLS) enabled.
# Replace with your actual publishable key (do not commit real keys to Git):
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional compatible alias (the app accepts either variable):
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
