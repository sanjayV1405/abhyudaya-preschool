# ==============================================================================
# Abhyudaya Preschool — Supabase & Environment Configuration
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Public Key (safe to use in browser with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here

# Optional: Supabase Anon Key alias (either key name will be recognized)
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
