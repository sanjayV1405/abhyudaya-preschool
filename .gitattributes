# Binary file handling — no LFS, no text conversion
# Images and static assets are stored directly as regular Git objects so Vercel, Netlify, etc. can serve them.

# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.tiff binary
*.tif  binary
*.ico  binary
*.webp binary
*.svg  text eol=lf

# Fonts & Documents
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary

# Archives
*.zip binary
*.tar binary
*.gz  binary
*.7z  binary

# Standard text files
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
