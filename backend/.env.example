# ==============================================================================
# Abhyudaya Preschool — Hybrid Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# CORS Allowed Origins (comma-separated list for local development and Firebase production hosting)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://abhyudaya-preschool.web.app,https://abhyudaya-preschool.firebaseapp.com

# Supabase Configuration (Used strictly by authMiddleware to authoritatively verify Supabase admin JWTs)
SUPABASE_URL=https://pvkmybgmbgwpqzorkmsh.supabase.co
SUPABASE_ANON_KEY=sb_publishable_tVX5HwAd10NuJ8bQeeD47A_WpflZZP5

# Optional: Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API -> JWT Secret)
# If provided, token signatures can be verified offline via HMAC SHA-256.
# If omitted, the middleware securely verifies tokens against Supabase's auth service.
SUPABASE_JWT_SECRET=

# Optional: Dedicated Admin API Key for internal automation / health inspection
ADMIN_API_KEY=

# ── Email Notification Settings (Nodemailer / Gmail SMTP) ──────────────────────
# Gmail address used as the sender for enquiry notification emails
MAIL_USER=your_gmail@gmail.com
# Gmail App Password (16 characters, no spaces) — NOT your regular Gmail password
# Generate at: https://myaccount.google.com/apppasswords
MAIL_PASS=your_gmail_app_password
# Optional: custom "From" display name + address
# MAIL_FROM="Abhyudaya Preschool" <your_gmail@gmail.com>
# Primary recipient for enquiry alerts (school email)
NOTIFY_EMAIL=daycare@abhyudaya-school.com
# jothisanjay659@gmail.com is hardcoded as a second recipient in enquiryController.js

