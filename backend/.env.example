# ==============================================================================
# Abhyudaya Preschool — Hybrid Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# CORS Allowed Origins (comma-separated list for local development and Firebase production hosting)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://abhyudaya-preschool.web.app,https://abhyudaya-preschool.firebaseapp.com

# Supabase Configuration (Used strictly by authMiddleware to authoritatively verify Supabase admin JWTs)
SUPABASE_URL=https://pvkmybgmbgwpqzorkmsh.supabase.co
SUPABASE_ANON_KEY=sb_publishable_tVX5HwAd10NuJ8bQeeD47A_WpflZZP5

# Optional: Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API -> JWT Secret)
# If provided, token signatures can be verified offline via HMAC SHA-256.
# If omitted, the middleware securely verifies tokens against Supabase's auth service.
SUPABASE_JWT_SECRET=

# Optional: Dedicated Admin API Key for internal automation / health inspection
ADMIN_API_KEY=

# ── Email Notification Settings (Google Gmail REST API with OAuth2) ───────────
# Google Cloud Console OAuth 2.0 Client ID (Web Application or Desktop)
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# Google Cloud Console OAuth 2.0 Client Secret
GMAIL_CLIENT_SECRET=GOCSPX-your_oauth_client_secret

# OAuth 2.0 Refresh Token (generated via Google OAuth 2.0 Playground for https://www.googleapis.com/auth/gmail.send)
GMAIL_REFRESH_TOKEN=1//your_long_lived_refresh_token

# Authorized Gmail account used to send the emails
GMAIL_USER=abhyudayapreschool@gmail.com

# Optional: Redirect URI configured in Google Cloud Console (defaults to https://developers.google.com/oauthplayground)
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# Optional: Custom From header display (defaults to "Abhyudaya Preschool" <abhyudayapreschool@gmail.com>)
MAIL_FROM="Abhyudaya Preschool" <abhyudayapreschool@gmail.com>

# Note: All 3 mandatory recipients receive notifications automatically:
# - daycare@abhyudaya-school.com
# - jothisanjay659@gmail.com
# - abhyudayapreschool@gmail.com
# Optional: Comma-separated list for any additional recipient addresses:
NOTIFY_EMAIL=

